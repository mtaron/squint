# AWS CLI and SDK profiles for this repo; mise points AWS_CONFIG_FILE here.
# squint-dev targets Floci in the dev cluster through the gateway.
[profile squint-dev]
# Keep in sync with s3.region in infrastructure/environments/development.yaml
region = us-west-2
endpoint_url = https://floci.squint.loc
# Floci accepts any credentials
aws_access_key_id = test
aws_secret_access_key = test
# Virtual-hosted names like bucket.floci.squint.loc have no DNS or certificate
s3 =
  addressing_style = path
