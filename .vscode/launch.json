{
    "version": "0.2.0",
    // Requires `tilt up`: the workers run under debugpy and Tilt forwards each one's port.
    "configurations": [
        {
            "name": "ingest",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/squint/python",
                    "remoteRoot": "/app"
                }
            ],
            "redirectOutput": true
        },
        {
            "name": "embed",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5679
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/squint/python",
                    "remoteRoot": "/app"
                }
            ],
            "redirectOutput": true
        },
        {
            "name": "extract",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5680
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/squint/python",
                    "remoteRoot": "/app"
                }
            ],
            "redirectOutput": true
        }
    ]
}
