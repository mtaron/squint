{
    "version": "0.2.0",
    // Requires `tilt up`: the workers run under debugpy and Tilt forwards each one's port.
    "configurations": [
        {
            "name": "ingest",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/squint/python/apps/ingest",
                    "remoteRoot": "/app/apps/ingest"
                },
                {
                    "localRoot": "${workspaceFolder}/squint/python/packages",
                    "remoteRoot": "/app/packages"
                }
            ],
            "redirectOutput": true
        },
        {
            "name": "embed",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5679
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/squint/python/apps/embed",
                    "remoteRoot": "/app/apps/embed"
                },
                {
                    "localRoot": "${workspaceFolder}/squint/python/packages",
                    "remoteRoot": "/app/packages"
                }
            ],
            "redirectOutput": true
        },
        {
            "name": "extract",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5680
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/squint/python/apps/extract",
                    "remoteRoot": "/app/apps/extract"
                },
                {
                    "localRoot": "${workspaceFolder}/squint/python/packages",
                    "remoteRoot": "/app/packages"
                }
            ],
            "redirectOutput": true
        }
    ]
}
