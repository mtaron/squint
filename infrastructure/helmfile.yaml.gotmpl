environments:
  development:
    values:
      - environments/development.yaml
    kubeContext: kind-squint

---
repositories:
  - name: milvus-operator
    url: https://zilliztech.github.io/milvus-operator/
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: temporal
    url: https://go.temporal.io/helm-charts/
  - name: vllm
    url: https://vllm-project.github.io/production-stack

helmDefaults:
  wait: true
  waitForJobs: true
  atomic: {{ ne .Environment.Name "development" | toYaml }}
  cleanupOnFail: {{ ne .Environment.Name "development" | toYaml }}
  historyMax: 5

releases:
  # Gateway is the modern Ingress, but shipped out of band
  # Use `task vendor-crds` to update
  # https://github.com/kubernetes-sigs/gateway-api
  - name: gateway-api-crds
    namespace: default
    chart: ./gateway-api

  # Node Feature Discovery
  # Labels nodes with their hardware features, which the GPU operator uses to find GPU nodes
  # https://github.com/kubernetes-sigs/node-feature-discovery
  - name: node-feature-discovery
    namespace: node-feature-discovery
    createNamespace: true
    chart: oci://registry.k8s.io/nfd/charts/node-feature-discovery
    version: "0.19.0"
    values:
      - worker:
          tolerations:
            - key: nvidia.com/gpu
              operator: Exists
              effect: NoSchedule

  # cert-manager
  # Issues and renews TLS certificates for in-cluster services
  # https://github.com/cert-manager/cert-manager
  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: oci://quay.io/jetstack/charts/cert-manager
    version: "1.21.2"
    values:
      - crds:
          enabled: true

  # The self-signed squint CA and the ClusterIssuer that signs service certificates with it
  - name: cluster-issuer
    namespace: cert-manager
    chart: ./cluster-issuer
    needs:
      - cert-manager/cert-manager

  # trust-manager
  # Distributes the squint CA to namespaces as a trust bundle
  # https://github.com/cert-manager/trust-manager
  - name: trust-manager
    namespace: cert-manager
    chart: oci://quay.io/jetstack/charts/trust-manager
    version: "v0.25.0"
    needs:
      - cert-manager/cert-manager
    values:
      - defaultPackage:
          enabled: false
      # temporal-worker-controller Connections read the CA from a Secret
      - secretTargets:
          enabled: true
          authorizedSecrets:
            - squint-ca-cert

  # kube-prometheus-stack
  # Prometheus, Alertmanager, Grafana, node-exporter and kube-state-metrics with their operator
  # https://github.com/prometheus-community/helm-charts/tree/main/charts/kube-prometheus-stack
  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
    version: "92.3.1"
    values:
      - prometheus:
          prometheusSpec:
            serviceMonitorSelectorNilUsesHelmValues: false
            podMonitorSelectorNilUsesHelmValues: false
            probeSelectorNilUsesHelmValues: false
            ruleSelectorNilUsesHelmValues: false
            retention: 15d
            resources:
              requests:
                cpu: 200m
                memory: 512Mi
              limits:
                memory: 1Gi
        alertmanager:
          alertmanagerSpec:
            resources:
              requests:
                cpu: 50m
                memory: 64Mi
              limits:
                memory: 128Mi
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeProxy:
          enabled: false
        kubeEtcd:
          enabled: false
        prometheus-node-exporter:
          prometheus:
            monitor:
              # Power supplies (on kind, the host's peripherals) reuse the model_name label that
              # the vLLM dashboards list models by
              metricRelabelings:
                - sourceLabels: [__name__]
                  regex: node_power_supply_.*
                  action: drop
        grafana:
          defaultDashboardsEnabled: true
          sidecar:
            dashboards:
              # Any value, since some charts label dashboards with their name rather than "1"
              labelValue: ""
          additionalDataSources:
            - name: Tempo
              type: tempo
              uid: tempo
              url: http://tempo.monitoring.svc:3200
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
        additionalPrometheusRulesMap:
          temporal-worker-scaling:
            groups:
              - name: temporal-worker-slots
                interval: 10s
                rules:
                  # Fraction of each worker version's task slots in use, from 0 (idle) to 1
                  # (saturated), for the per-version HPAs that squint-worker attaches. The
                  # Temporal server's own workers report slots too, without version labels.
                  # Adapted from the temporal-worker-controller demo, without its task queue filter:
                  # https://github.com/temporalio/temporal-worker-controller/blob/v1.13.0/internal/demo/k8s/prometheus-stack-values.yaml
                  - record: temporal_slot_utilization
                    expr: |
                      sum by (temporal_worker_deployment_name, temporal_worker_build_id, temporal_namespace, worker_type) (
                        temporal_worker_task_slots_used{temporal_worker_deployment_name!=""}
                      )
                      /
                      clamp_min(
                        sum by (temporal_worker_deployment_name, temporal_worker_build_id, temporal_namespace, worker_type) (
                          temporal_worker_task_slots_used{temporal_worker_deployment_name!=""}
                          + temporal_worker_task_slots_available{temporal_worker_deployment_name!=""}
                        ),
                        1
                      )
      {{- with .Values | get "kube-prometheus-stack.values" nil }}
      {{- toYaml . | nindent 6 }}
      {{- end }}

  # Dashboards for components whose charts don't ship one, vendored by `task vendor-dashboards`,
  # and for squint's own charts
  - name: dashboards
    namespace: monitoring
    chart: ./dashboards
    needs:
      - monitoring/kube-prometheus-stack

  # Prometheus Adapter
  # Serves Prometheus metrics through the Kubernetes custom and external metrics APIs
  # https://github.com/prometheus-community/helm-charts/tree/main/charts/prometheus-adapter
  - name: prometheus-adapter
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/prometheus-adapter
    version: "5.3.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - prometheus:
          url: http://kube-prometheus-stack-prometheus.monitoring.svc
          port: 9090
      - rules:
          external:
            # Selected per worker version by the labels temporal-worker-controller injects into
            # each HPA's matchLabels. Adapted from the temporal-worker-controller demo:
            # https://github.com/temporalio/temporal-worker-controller/blob/v1.13.0/internal/demo/k8s/prometheus-adapter-values.yaml
            - seriesQuery: 'temporal_slot_utilization{}'
              metricsQuery: 'avg(<<.Series>>{<<.LabelMatchers>>})'
              name:
                as: temporal_slot_utilization
              resources:
                namespaced: false

  # Grafana Tempo
  # Trace store, receiving OTLP and queried from Grafana
  # https://github.com/grafana-community/helm-charts/tree/main/charts/tempo
  - name: tempo
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/grafana-community/helm-charts/tempo
    version: "3.2.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - tempo:
          reportingEnabled: false
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              memory: 1Gi
        serviceMonitor:
          enabled: true

  # Milvus Operator
  # Milvus is a vector database that support late embedding vectors
  # https://github.com/zilliztech/milvus-operator
  - name: milvus-operator
    namespace: milvus-operator
    createNamespace: true
    chart: milvus-operator/milvus-operator
    version: "1.3.11"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - monitoringEnabled: true

  # https://github.com/milvus-io/milvus
  - name: milvus
    namespace: milvus
    createNamespace: true
    chart: ./milvus
    forceConflicts: true
    needs:
      - cert-manager/cluster-issuer
      - milvus-operator/milvus-operator
    {{- with .Values | get "milvus.values" nil }}
    values:
      {{- toYaml . | nindent 6 }}
    {{- end }}

  # CloudNativePG
  # Operator that runs PostgreSQL clusters
  # https://github.com/cloudnative-pg/charts
  # I would probably just use Neon if deploying this for real
  - name: cnpg
    namespace: cnpg-system
    createNamespace: true
    chart: cnpg/cloudnative-pg
    version: "0.29.1"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - monitoring:
          podMonitorEnabled: true
          grafanaDashboard:
            create: true

  - name: postgres
    namespace: postgres
    createNamespace: true
    chart: cnpg/cluster
    version: "0.9.0"
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-postgres-temporal-role-secret.sh"]
    {{- end }}
    needs:
      - cnpg-system/cnpg
      - monitoring/kube-prometheus-stack
    values:
      - cluster:
          instances: 2
          monitoring:
            enabled: true
          roles:
            - name: temporal
              ensure: present
              login: true
              createdb: true
              passwordSecret:
                name: temporal-db-secret

  # Certificates for the Temporal frontend and its Web UI client
  - name: temporal-tls
    namespace: temporal
    createNamespace: true
    chart: ./temporal-tls
    needs:
      - cert-manager/cluster-issuer

  # Temporal
  # Workflow engine for durable execution
  # https://github.com/temporalio/helm-charts
  - name: temporal
    namespace: temporal
    createNamespace: true
    chart: temporal/temporal
    version: "1.7.0"
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-temporal-db-secret.sh"]
    {{- end }}
    needs:
      - postgres/postgres
      - monitoring/kube-prometheus-stack
      - temporal/temporal-tls
    values:
      - server:
          metrics:
            serviceMonitor:
              enabled: true
          tls:
            frontend:
              enabled: true
              secretName: temporal-frontend-tls
              serverName: &temporalFrontendHost temporal-frontend.temporal.svc.cluster.local
          config:
            namespaces:
              create: true
              namespace:
                - name: default
                  retention: 3d
            persistence:
              datastores:
                default:
                  sql: &temporalSql
                    pluginName: postgres12_pgx
                    driverName: postgres12_pgx
                    databaseName: temporal
                    connectAddr: postgres-cluster-rw.postgres.svc.cluster.local:5432
                    connectProtocol: tcp
                    user: temporal
                    existingSecret: temporal-db-secret
                visibility:
                  sql:
                    <<: *temporalSql
                    databaseName: temporal_visibility
        # The Web UI's connection to the frontend; browsers reach the UI through the gateway
        web:
          tls:
            enabled: true
            secretName: temporal-web-tls
            serverName: *temporalFrontendHost
            enableHostVerification: true
      {{- with .Values | get "temporal.values" nil }}
      {{- toYaml . | nindent 6 }}
      {{- end }}

  # Temporal Worker Controller
  # Manages worker versioning, traffic routing, and progressive rollout
  # https://github.com/temporalio/temporal-worker-controller
  - name: temporal-worker-controller-crds
    chart: oci://docker.io/temporalio/temporal-worker-controller-crds
    namespace: default
    version: "0.32.0"

  - name: temporal-worker-controller
    chart: oci://docker.io/temporalio/temporal-worker-controller
    namespace: temporal
    version: "0.32.0"
    needs:
      - temporal/temporal
      - default/temporal-worker-controller-crds

  # Dragonfly Operator
  # Redis-compatible cache
  # https://github.com/dragonflydb/dragonfly-operator
  - name: dragonfly-operator
    namespace: dragonfly-operator
    createNamespace: true
    chart: oci://ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator
    version: "v1.7.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - serviceMonitor:
          enabled: true
      - grafanaDashboard:
          enabled: true

  # https://github.com/dragonflydb/dragonfly
  - name: dragonfly
    namespace: dragonfly
    createNamespace: true
    chart: ./dragonfly
    needs:
      - cert-manager/cluster-issuer
      - dragonfly-operator/dragonfly-operator

  # NVIDIA GPU Operator
  # Device plugin, GPU feature discovery and DCGM metrics for GPU nodes
  # https://github.com/NVIDIA/gpu-operator
  - name: gpu-operator
    namespace: gpu-operator
    createNamespace: true
    chart: oci://nvcr.io/nvidia/cloud-native-charts/gpu-operator
    version: "v26.7.1"
    needs:
      - node-feature-discovery/node-feature-discovery
      - monitoring/kube-prometheus-stack
    values:
      - nfd:
          enabled: false
      - dcgmExporter:
          serviceMonitor:
            relabelings:
              # Name GPUs by node rather than by the exporter pod's address
              - sourceLabels: [__meta_kubernetes_pod_node_name]
                targetLabel: instance
      {{- $gpuReplicas := .Values | get "gpu-operator.timeSlicing.replicas" 1 | int }}
      {{- if gt $gpuReplicas 1 }}
      # Time-slicing has no memory isolation; size GPU workloads to fit together
      - devicePlugin:
          config:
            create: true
            name: time-slicing
            default: time-slicing
            data:
              time-slicing: |-
                version: v1
                sharing:
                  timeSlicing:
                    failRequestsGreaterThanOne: true
                    resources:
                      - name: nvidia.com/gpu
                        replicas: {{ $gpuReplicas }}
      {{- end }}
      {{- with .Values | get "gpu-operator.values" nil }}
      {{- toYaml . | nindent 6 }}
      {{- end }}

  # vLLM production stack
  # Serves Qwen3-VL for extraction; the vLLM image tag is in modelSpec below
  # https://github.com/vllm-project/production-stack
  # https://github.com/vllm-project/vllm
  - name: qwen3-vl
    namespace: vllm
    createNamespace: true
    chart: vllm/vllm-stack
    version: "0.1.13"
    timeout: 1200
    needs:
      - gpu-operator/gpu-operator
      - monitoring/kube-prometheus-stack
    values:
      - servingEngineSpec:
          runtimeClassName: ""
          tolerations:
            - key: nvidia.com/gpu
              operator: Exists
              effect: NoSchedule
          labels:
            environment: null
            release: null
          strategy:
            type: Recreate
          serviceMonitor:
            enabled: true
          modelSpec:
            - name: vllm
              repository: vllm/vllm-openai
              tag: v0.33.0
              modelURL: /mnt/models/Qwen3-VL-4B-Instruct
              replicaCount: 1
              requestCPU: 4
              requestMemory: 12Gi
              requestGPU: 1
              vllmConfig:
                # Up to 4096 image tokens (the cap below) plus up to 4096 output tokens and the prompt
                maxModelLen: 12288
                # The dev GPU also runs the desktop and the embed worker (~1.9 GiB peak)
                gpuMemoryUtilization: {{ eq .Environment.Name "development" | ternary 0.72 0.85 }}
                {{- if eq .Environment.Name "development" }}
                # The dev KV cache holds about one full-length request; more sequences only add
                # CUDA graph memory
                maxNumSeqs: 8
                {{- end }}
                extraArgs:
                  - --served-model-name
                  - qwen3-vl
                  - --limit-mm-per-prompt
                  - '{"image": 1, "video": 0}'
                  # 4096 visual tokens of 32x32 px (4.2 MP). Small type needs more than a 144 dpi
                  # letter page's 2048: a 6x9 in reference page read correctly only at ~2600.
                  # Boxes are relative (0-1000), so server-side resizing doesn't affect them.
                  - --mm-processor-kwargs
                  - '{"size": {"longest_edge": 4194304, "shortest_edge": 65536}}'
              {{- if eq .Environment.Name "development" }}
              extraVolumes:
                - name: models
                  hostPath:
                    path: /mnt/models
                    type: Directory
              extraVolumeMounts:
                - name: models
                  mountPath: /mnt/models
                  readOnly: true
              {{- end }}
      - routerSpec:
          enableRouter: false
      - grafanaDashboards:
          enabled: true

  # agentgateway
  # Gateway API implementation
  # https://github.com/agentgateway/agentgateway
  - name: agentgateway-crds
    namespace: agentgateway-system
    createNamespace: true
    chart: oci://cr.agentgateway.dev/charts/agentgateway-crds
    version: "v1.6.0"

  - name: agentgateway
    namespace: agentgateway-system
    chart: oci://cr.agentgateway.dev/charts/agentgateway
    version: "v1.6.0"
    needs:
      - default/gateway-api-crds
      - agentgateway-system/agentgateway-crds
      - monitoring/kube-prometheus-stack
    values:
      - monitoring:
          enabled: true

  - name: networking
    namespace: agentgateway-system
    chart: ./networking
    needs:
      - agentgateway-system/agentgateway

  # Versity S3 Gateway
  # S3-compatible object storage on a local volume, standing in for S3 in development
  # https://github.com/versity/versitygw
  - name: versitygw
    namespace: versitygw
    installed: {{ eq .Environment.Name "development" | toYaml }}
    createNamespace: true
    chart: oci://ghcr.io/versity/versitygw/charts/versitygw
    version: "0.4.5"
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-versitygw-root-secret.sh"]
    needs:
      - agentgateway-system/agentgateway
      - cert-manager/cert-manager
      - cert-manager/cluster-issuer
    values:
      - auth:
          existingSecret: versitygw-root-secret
      - gateway:
          region: {{ .Values.s3.region }}
          backend:
            type: posix
      - persistence:
          enabled: true
      - tls:
          enabled: true
      - certificate:
          create: true
          dnsNames:
            - versitygw.versitygw.svc.cluster.local
          issuerRef:
            group: cert-manager.io
            kind: ClusterIssuer
            name: squint-ca

  # Cluster configuration and secrets for squint services
  - name: squint
    namespace: squint
    createNamespace: true
    chart: ./squint
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-squint-secrets.sh"]
    {{- end }}
    needs:
      - cert-manager/cluster-issuer
      - cert-manager/trust-manager
      - default/temporal-worker-controller-crds
      {{- if eq .Environment.Name "development" }}
      - postgres/postgres
      - versitygw/versitygw
      {{- end }}
    values:
      - s3:
          region: {{ .Values.s3.region }}

  # Applies the migrations in squint/javascript/db/drizzle before the services that use them
  # `task migrate` reruns it, since `apply` skips the release when only the migrations changed
  - name: migrate
    namespace: squint
    chart: ./squint-migrate
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-migrate-image.sh", {{ .Values.migrate.image | quote }}]
    {{- end }}
    needs:
      - squint/squint
    values:
      - image: {{ .Values.migrate.image }}
        {{- if eq .Environment.Name "development" }}
        # Rebuilt under the same tag
        imagePullPolicy: Always
        {{- end }}
