environments:
  development:
    values:
      - environments/development.yaml
    kubeContext: kind-squint

---
repositories:
  - name: milvus-operator
    url: https://zilliztech.github.io/milvus-operator/
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: temporal
    url: https://go.temporal.io/helm-charts/
  - name: vllm
    url: https://vllm-project.github.io/production-stack

helmDefaults:
  wait: true
  waitForJobs: true
  atomic: {{ ne .Environment.Name "development" | toYaml }}
  cleanupOnFail: {{ ne .Environment.Name "development" | toYaml }}
  historyMax: 5

releases:
  - name: gateway-api-crds
    namespace: default
    chart: ./gateway-api

  - name: node-feature-discovery
    namespace: node-feature-discovery
    createNamespace: true
    chart: oci://registry.k8s.io/nfd/charts/node-feature-discovery
    version: "0.19.0"
    values:
      - worker:
          tolerations:
            - key: nvidia.com/gpu
              operator: Exists
              effect: NoSchedule

  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: oci://quay.io/jetstack/charts/cert-manager
    version: "1.21.2"
    values:
      - crds:
          enabled: true

  - name: cluster-issuer
    namespace: cert-manager
    chart: ./cluster-issuer
    needs:
      - cert-manager/cert-manager

  - name: trust-manager
    namespace: cert-manager
    chart: oci://quay.io/jetstack/charts/trust-manager
    version: "v0.25.0"
    needs:
      - cert-manager/cert-manager
    values:
      - defaultPackage:
          enabled: false

  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
    version: "91.4.1"
    values:
      - prometheus:
          prometheusSpec:
            serviceMonitorSelectorNilUsesHelmValues: false
            podMonitorSelectorNilUsesHelmValues: false
            probeSelectorNilUsesHelmValues: false
            ruleSelectorNilUsesHelmValues: false
            retention: 15d
            resources:
              requests:
                cpu: 200m
                memory: 512Mi
              limits:
                memory: 1Gi
        alertmanager:
          alertmanagerSpec:
            resources:
              requests:
                cpu: 50m
                memory: 64Mi
              limits:
                memory: 128Mi
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeProxy:
          enabled: false
        kubeEtcd:
          enabled: false
        grafana:
          defaultDashboardsEnabled: true
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
          {{- with .Values | get "kube-prometheus-stack.grafana" nil }}
          {{- toYaml . | nindent 10 }}
          {{- end }}

  - name: prometheus-adapter
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/prometheus-adapter
    version: "5.3.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - prometheus:
          url: http://kube-prometheus-stack-prometheus.monitoring.svc
          port: 9090

  - name: milvus-operator
    namespace: milvus-operator
    createNamespace: true
    chart: milvus-operator/milvus-operator
    version: "1.3.11"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - monitoringEnabled: true

  - name: milvus
    namespace: milvus
    createNamespace: true
    chart: ./milvus
    forceConflicts: true
    needs:
      - cert-manager/cluster-issuer
      - milvus-operator/milvus-operator

  - name: cnpg
    namespace: cnpg-system
    createNamespace: true
    chart: cnpg/cloudnative-pg
    version: "0.29.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - monitoring:
          podMonitorEnabled: true
          grafanaDashboard:
            create: true

  - name: postgres
    namespace: postgres
    createNamespace: true
    chart: cnpg/cluster
    version: "0.8.1"
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-postgres-temporal-role-secret.sh"]
    {{- end }}
    needs:
      - cnpg-system/cnpg
      - monitoring/kube-prometheus-stack
    values:
      - cluster:
          instances: 2
          monitoring:
            enabled: true
          roles:
            - name: temporal
              ensure: present
              login: true
              createdb: true
              passwordSecret:
                name: temporal-db-secret

  - name: temporal
    namespace: temporal
    createNamespace: true
    chart: temporal/temporal
    version: "1.7.0"
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-temporal-db-secret.sh"]
    {{- end }}
    needs:
      - postgres/postgres
      - monitoring/kube-prometheus-stack
    values:
      - server:
          metrics:
            serviceMonitor:
              enabled: true
          config:
            persistence:
              datastores:
                default:
                  sql: &temporalSql
                    pluginName: postgres12_pgx
                    driverName: postgres12_pgx
                    databaseName: temporal
                    connectAddr: postgres-cluster-rw.postgres.svc.cluster.local:5432
                    connectProtocol: tcp
                    user: temporal
                    existingSecret: temporal-db-secret
                visibility:
                  sql:
                    <<: *temporalSql
                    databaseName: temporal_visibility

  # Temporal Worker Controller
  # Manages worker versioning, traffic routing, and progressive rollout
  # https://github.com/temporalio/temporal-worker-controller
  - name: temporal-worker-controller-crds
    chart: oci://docker.io/temporalio/temporal-worker-controller-crds
    namespace: default
    version: "0.30.0"

  - name: temporal-worker-controller
    chart: oci://docker.io/temporalio/temporal-worker-controller
    namespace: temporal
    version: "0.30.0"
    needs:
      - temporal/temporal
      - default/temporal-worker-controller-crds

  - name: dragonfly-operator
    namespace: dragonfly-operator
    createNamespace: true
    chart: oci://ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator
    version: "v1.7.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - serviceMonitor:
          enabled: true
      - grafanaDashboard:
          enabled: true

  - name: dragonfly
    namespace: dragonfly
    createNamespace: true
    chart: ./dragonfly
    needs:
      - cert-manager/cluster-issuer
      - dragonfly-operator/dragonfly-operator

  - name: gpu-operator
    namespace: gpu-operator
    createNamespace: true
    chart: oci://nvcr.io/nvidia/cloud-native-charts/gpu-operator
    version: "v26.7.1"
    needs:
      - node-feature-discovery/node-feature-discovery
      - monitoring/kube-prometheus-stack
    values:
      - nfd:
          enabled: false
      {{- $gpuReplicas := .Values | get "gpu-operator.timeSlicing.replicas" 1 | int }}
      {{- if gt $gpuReplicas 1 }}
      # Time-slicing has no memory isolation; size GPU workloads to fit together
      - devicePlugin:
          config:
            create: true
            name: time-slicing
            default: time-slicing
            data:
              time-slicing: |-
                version: v1
                sharing:
                  timeSlicing:
                    failRequestsGreaterThanOne: true
                    resources:
                      - name: nvidia.com/gpu
                        replicas: {{ $gpuReplicas }}
      {{- end }}
      {{- with .Values | get "gpu-operator.values" nil }}
      {{- toYaml . | nindent 6 }}
      {{- end }}

  - name: qwen-vl
    namespace: vllm
    createNamespace: true
    chart: vllm/vllm-stack
    version: "0.1.13"
    timeout: 1200
    needs:
      - gpu-operator/gpu-operator
      - monitoring/kube-prometheus-stack
    values:
      - servingEngineSpec:
          runtimeClassName: ""
          tolerations:
            - key: nvidia.com/gpu
              operator: Exists
              effect: NoSchedule
          labels:
            environment: null
            release: null
          strategy:
            type: Recreate
          serviceMonitor:
            enabled: true
          modelSpec:
            - name: vllm
              repository: vllm/vllm-openai
              tag: v0.31.0
              modelURL: /mnt/models/Qwen3.5-9B-NVFP4
              replicaCount: 1
              requestCPU: 4
              requestMemory: 12Gi
              requestGPU: 1
              vllmConfig:
                # A page is at most 2048 image tokens (the cap below) plus a structured answer
                maxModelLen: 16384
                # The default of 256 reserves per-sequence GatedDeltaNet state and CUDA graphs that
                # overflow the dev GPU budget
                maxNumSeqs: 8
                # The dev GPU also runs the desktop and the embed worker (~1.9 GiB peak)
                gpuMemoryUtilization: {{ eq .Environment.Name "development" | ternary 0.72 0.85 }}
                extraArgs:
                  - --served-model-name
                  - qwen-vl
                  # Moves thinking into reasoning_content when a request enables it
                  - --reasoning-parser
                  - qwen3
                  - --limit-mm-per-prompt
                  - '{"image": 1, "video": 0}'
                  # 2048 visual tokens of 32x32 px (a 144 dpi letter page) so the encoder isn't profiled for
                  # 16 MP images. Boxes are relative (0-1000), so server-side resizing doesn't affect them.
                  - --mm-processor-kwargs
                  - '{"size": {"longest_edge": 2097152, "shortest_edge": 65536}}'
              {{- if eq .Environment.Name "development" }}
              extraVolumes:
                - name: models
                  hostPath:
                    path: /mnt/models
                    type: Directory
              extraVolumeMounts:
                - name: models
                  mountPath: /mnt/models
                  readOnly: true
              {{- end }}
      - routerSpec:
          enableRouter: false
      - grafanaDashboards:
          enabled: true

  - name: agentgateway-crds
    namespace: agentgateway-system
    createNamespace: true
    chart: oci://cr.agentgateway.dev/charts/agentgateway-crds
    version: "v1.5.0"

  - name: agentgateway
    namespace: agentgateway-system
    chart: oci://cr.agentgateway.dev/charts/agentgateway
    version: "v1.5.0"
    needs:
      - default/gateway-api-crds
      - agentgateway-system/agentgateway-crds
      - monitoring/kube-prometheus-stack
    values:
      - monitoring:
          enabled: true

  - name: networking
    namespace: agentgateway-system
    chart: ./networking
    needs:
      - agentgateway-system/agentgateway

  - name: versitygw
    namespace: versitygw
    installed: {{ eq .Environment.Name "development" | toYaml }}
    createNamespace: true
    chart: oci://ghcr.io/versity/versitygw/charts/versitygw
    version: "0.4.5"
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-versitygw-root-secret.sh"]
    needs:
      - agentgateway-system/agentgateway
      - cert-manager/cert-manager
      - cert-manager/cluster-issuer
    values:
      - auth:
          existingSecret: versitygw-root-secret
      - gateway:
          region: {{ .Values.s3.region }}
          backend:
            type: posix
      - persistence:
          enabled: true
      - tls:
          enabled: true
      - certificate:
          create: true
          dnsNames:
            - versitygw.versitygw.svc.cluster.local
          issuerRef:
            group: cert-manager.io
            kind: ClusterIssuer
            name: squint-ca

  - name: squint
    namespace: squint
    createNamespace: true
    chart: ./squint
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-squint-secrets.sh"]
    {{- end }}
    needs:
      - cert-manager/cluster-issuer
      - cert-manager/trust-manager
      {{- if eq .Environment.Name "development" }}
      - postgres/postgres
      - versitygw/versitygw
      {{- end }}
    values:
      - s3:
          region: {{ .Values.s3.region }}


