environments:
  development:
    values:
      - environments/development.yaml
    kubeContext: kind-squint

---
repositories:
  - name: milvus-operator
    url: https://zilliztech.github.io/milvus-operator/
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: temporal
    url: https://go.temporal.io/helm-charts/
  - name: vllm
    url: https://vllm-project.github.io/production-stack

helmDefaults:
  wait: true
  waitForJobs: true
  atomic: {{ ne .Environment.Name "development" | toYaml }}
  cleanupOnFail: {{ ne .Environment.Name "development" | toYaml }}
  historyMax: 5

releases:
  - name: gateway-api-crds
    namespace: default
    chart: ./gateway-api

  - name: node-feature-discovery
    namespace: node-feature-discovery
    createNamespace: true
    chart: oci://registry.k8s.io/nfd/charts/node-feature-discovery
    version: "0.19.0"

  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: oci://quay.io/jetstack/charts/cert-manager
    version: "1.21.2"
    values:
      - crds:
          enabled: true

  # Internal CAs for mTLS between squint and its backing services
  - name: pki
    namespace: cert-manager
    chart: ./pki
    needs:
      - cert-manager/cert-manager

  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
    version: "91.4.1"
    values:
      - prometheus:
          prometheusSpec:
            serviceMonitorSelectorNilUsesHelmValues: false
            podMonitorSelectorNilUsesHelmValues: false
            probeSelectorNilUsesHelmValues: false
            ruleSelectorNilUsesHelmValues: false
            retention: 15d
            resources:
              requests:
                cpu: 200m
                memory: 512Mi
              limits:
                memory: 1Gi
        alertmanager:
          alertmanagerSpec:
            resources:
              requests:
                cpu: 50m
                memory: 64Mi
              limits:
                memory: 128Mi
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeProxy:
          enabled: false
        kubeEtcd:
          enabled: false
        grafana:
          defaultDashboardsEnabled: true
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
          {{- with .Values | get "kube-prometheus-stack.grafana" nil }}
          {{- toYaml . | nindent 10 }}
          {{- end }}

  - name: prometheus-adapter
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/prometheus-adapter
    version: "5.3.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - prometheus:
          url: http://kube-prometheus-stack-prometheus.monitoring.svc
          port: 9090

  - name: milvus-operator
    namespace: milvus-operator
    createNamespace: true
    chart: milvus-operator/milvus-operator
    version: "1.3.11"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - monitoringEnabled: true

  - name: cnpg
    namespace: cnpg-system
    createNamespace: true
    chart: cnpg/cloudnative-pg
    version: "0.29.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - monitoring:
          podMonitorEnabled: true
          grafanaDashboard:
            create: true

  - name: postgres-certs
    namespace: postgres
    createNamespace: true
    chart: ./certificates
    needs:
      - cert-manager/pki
    values:
      - certificates:
          - name: postgres-server-tls
            issuer: postgres-ca
            dnsNames:
              {{- range $svc := list "rw" "ro" "r" }}
              - postgres-cluster-{{ $svc }}
              - postgres-cluster-{{ $svc }}.postgres
              - postgres-cluster-{{ $svc }}.postgres.svc
              - postgres-cluster-{{ $svc }}.postgres.svc.cluster.local
              {{- end }}
            usages: [server auth]
            reload: true
          # Its ca.crt (postgres-ca) is also the CA that verifies client certificates
          - name: postgres-replication-tls
            issuer: postgres-ca
            commonName: streaming_replica
            usages: [client auth]
            reload: true

  - name: postgres
    namespace: postgres
    createNamespace: true
    chart: cnpg/cluster
    version: "0.8.1"
    needs:
      - cnpg-system/cnpg
      - monitoring/kube-prometheus-stack
      - postgres/postgres-certs
    values:
      - cluster:
          monitoring:
            enabled: true
          certificates:
            serverTLSSecret: postgres-server-tls
            serverCASecret: postgres-server-tls
            clientCASecret: postgres-replication-tls
            replicationTLSSecret: postgres-replication-tls
          postgresql:
            # Client certificate auth: the certificate CN must match the role.
            # These come before CNPG's password fallback rule.
            pg_hba:
              - hostssl temporal,temporal_visibility temporal all cert
              - hostssl squint squint all cert
          roles:
            - name: temporal
              ensure: present
              login: true
              disablePassword: true
            - name: squint
              ensure: present
              login: true
              disablePassword: true
        databases:
          - name: temporal
            owner: temporal
          - name: temporal_visibility
            owner: temporal
          - name: squint
            owner: squint

  - name: temporal-certs
    namespace: temporal
    createNamespace: true
    chart: ./certificates
    needs:
      - cert-manager/pki
    values:
      - certificates:
          - name: temporal-postgres-client
            issuer: postgres-ca
            commonName: temporal
            usages: [client auth]

  - name: temporal
    namespace: temporal
    createNamespace: true
    chart: temporal/temporal
    version: "1.7.0"
    needs:
      - postgres/postgres
      - temporal/temporal-certs
      - monitoring/kube-prometheus-stack
    values:
      - server:
          additionalVolumes: &postgresClientVolumes
            - name: postgres-client
              secret:
                secretName: temporal-postgres-client
                defaultMode: 0440
          additionalVolumeMounts: &postgresClientVolumeMounts
            - name: postgres-client
              mountPath: /etc/temporal/postgres
              readOnly: true
          metrics:
            serviceMonitor:
              enabled: true
          config:
            persistence:
              datastores:
                default:
                  sql: &temporalSql
                    pluginName: postgres12_pgx
                    driverName: postgres12_pgx
                    databaseName: temporal
                    connectAddr: postgres-cluster-rw.postgres.svc.cluster.local:5432
                    connectProtocol: tcp
                    user: temporal
                    # The postgres release creates the databases
                    createDatabase: false
                    # Authenticates with the client certificate; no password
                    tls:
                      enabled: true
                      caFile: /etc/temporal/postgres/ca.crt
                      certFile: /etc/temporal/postgres/tls.crt
                      keyFile: /etc/temporal/postgres/tls.key
                      enableHostVerification: true
                visibility:
                  sql:
                    <<: *temporalSql
                    databaseName: temporal_visibility
        # The schema job connects with the same TLS settings
        admintools:
          additionalVolumes: *postgresClientVolumes
          additionalVolumeMounts: *postgresClientVolumeMounts
        schema:
          # Server pods already default to this; the job needs it to read the key
          securityContext:
            fsGroup: 1000

  # Temporal Worker Controller
  # Manages worker versioning, traffic routing, and progressive rollout
  # https://github.com/temporalio/temporal-worker-controller
  - name: temporal-worker-controller-crds
    chart: oci://docker.io/temporalio/temporal-worker-controller-crds
    namespace: default
    version: "0.30.0"

  - name: temporal-worker-controller
    chart: oci://docker.io/temporalio/temporal-worker-controller
    namespace: temporal
    version: "0.30.0"
    needs:
      - temporal/temporal
      - default/temporal-worker-controller-crds

  - name: dragonfly-operator
    namespace: dragonfly-operator
    createNamespace: true
    chart: oci://ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator
    version: "v1.7.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - serviceMonitor:
          enabled: true
      - grafanaDashboard:
          enabled: true

  - name: dragonfly
    namespace: dragonfly
    createNamespace: true
    chart: ./dragonfly
    needs:
      - dragonfly-operator/dragonfly-operator
      - cert-manager/pki

  - name: gpu-operator
    namespace: gpu-operator
    createNamespace: true
    chart: oci://nvcr.io/nvidia/cloud-native-charts/gpu-operator
    version: "v26.7.1"
    needs:
      - node-feature-discovery/node-feature-discovery
      - monitoring/kube-prometheus-stack
    values:
      - nfd:
          enabled: false
      {{- with .Values | get "gpu-operator.values" nil }}
      {{- toYaml . | nindent 6 }}
      {{- end }}

  - name: dots-mocr
    namespace: vllm
    createNamespace: true
    chart: vllm/vllm-stack
    version: "0.1.13"
    timeout: 1200
    needs:
      - gpu-operator/gpu-operator
      - monitoring/kube-prometheus-stack
    values:
      - servingEngineSpec:
          runtimeClassName: ""
          labels:
            environment: null
            release: null
          strategy:
            type: Recreate
          serviceMonitor:
            enabled: true
          modelSpec:
            - name: vllm
              repository: vllm/vllm-openai
              tag: v0.31.0
              modelURL: /mnt/models/dots-mocr
              replicaCount: 1
              requestCPU: 4
              requestMemory: 12Gi
              requestGPU: 1
              vllmConfig:
                # Up to 14.4k image tokens (11.3 MP max) plus up to 16k of output
                maxModelLen: 32768
                # The dev GPU also drives the desktop, which holds ~3 GiB
                gpuMemoryUtilization: {{ eq .Environment.Name "development" | ternary 0.7 0.85 }}
                extraArgs:
                  - --served-model-name
                  - dots-mocr
                  # vLLM has no built-in dots_ocr config; it loads configuration_dots.py from the model dir
                  - --trust-remote-code
                  - --chat-template-content-format
                  - string
                  {{- if eq .Environment.Name "development" }}
                  # Cap images at 5120 visual tokens (a 200 dpi A4/letter page fits unscaled) so
                  # encoder profiling leaves room for KV cache on the shared desktop GPU
                  - --mm-processor-kwargs
                  - '{"max_pixels": 4014080}'
                  {{- end }}
              {{- if eq .Environment.Name "development" }}
              extraVolumes:
                - name: models
                  hostPath:
                    path: /mnt/models
                    type: Directory
              extraVolumeMounts:
                - name: models
                  mountPath: /mnt/models
                  readOnly: true
              {{- end }}
      - routerSpec:
          enableRouter: false
      - grafanaDashboards:
          enabled: true

  - name: agentgateway-crds
    namespace: agentgateway-system
    createNamespace: true
    chart: oci://cr.agentgateway.dev/charts/agentgateway-crds
    version: "v1.5.0"

  - name: agentgateway
    namespace: agentgateway-system
    chart: oci://cr.agentgateway.dev/charts/agentgateway
    version: "v1.5.0"
    needs:
      - default/gateway-api-crds
      - agentgateway-system/agentgateway-crds
      - monitoring/kube-prometheus-stack
    values:
      - monitoring:
          enabled: true

  - name: networking
    namespace: agentgateway-system
    chart: ./networking
    needs:
      - agentgateway-system/agentgateway

  - name: versitygw
    namespace: versitygw
    installed: {{ eq .Environment.Name "development" | toYaml }}
    createNamespace: true
    chart: oci://ghcr.io/versity/versitygw/charts/versitygw
    version: "0.4.4"
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-versitygw-root-secret.sh"]
    needs:
      - agentgateway-system/agentgateway
      - cert-manager/pki
    # The chart's readiness probe ignores tls.enabled and always uses plain HTTP
    jsonPatches:
      - target:
          group: apps
          version: v1
          kind: Deployment
          name: versitygw
        patch:
          - op: add
            path: /spec/template/spec/containers/0/readinessProbe/httpGet/scheme
            value: HTTPS
    values:
      - image:
          tag: v1.8.0
      - auth:
          existingSecret: versitygw-root-secret
      - tls:
          enabled: true
      - certificate:
          create: true
          dnsNames:
            - versitygw
            - versitygw.versitygw
            - versitygw.versitygw.svc
            - versitygw.versitygw.svc.cluster.local
          issuerRef:
            group: cert-manager.io
            kind: ClusterIssuer
            name: versitygw-ca
      # Per-app users are provisioned by the s3-users release
      - iam:
          enabled: true
          type: internal
          persistence:
            enabled: true
      - gateway:
          backend:
            type: posix
      - persistence:
          enabled: true

  - name: milvus
    namespace: milvus
    createNamespace: true
    chart: ./milvus
    forceConflicts: true
    needs:
      - milvus-operator/milvus-operator
      - cert-manager/pki

  - name: s3-users
    namespace: versitygw
    installed: {{ eq .Environment.Name "development" | toYaml }}
    chart: ./s3-users
    needs:
      - versitygw/versitygw
      - squint/squint-certs
    values:
      - users:
          - name: squint
            namespace: squint
            secretName: squint-s3
            role: userplus

  # Client credentials for the squint workloads, issued in their own namespace
  - name: squint-certs
    namespace: squint
    createNamespace: true
    chart: ./certificates
    needs:
      - cert-manager/pki
    values:
      - certificates:
          - name: squint-postgres
            issuer: postgres-ca
            commonName: squint
            usages: [client auth]
          - name: squint-dragonfly
            issuer: dragonfly-ca
            commonName: squint
            usages: [client auth]
          - name: squint-milvus
            issuer: milvus-ca
            commonName: squint
            usages: [client auth]

  - name: local-registry
    namespace: kube-public
    installed: {{ eq .Environment.Name "development" | toYaml }}
    chart: ./local-registry

