environments:
  development:
    values:
      - environments/development.yaml
    kubeContext: kind-squint

---
repositories:
  - name: milvus-operator
    url: https://zilliztech.github.io/milvus-operator/
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: temporal
    url: https://go.temporal.io/helm-charts/

helmDefaults:
  wait: true
  waitForJobs: true
  atomic: true
  cleanupOnFail: true
  historyMax: 5

releases:
  - name: gateway-api-crds
    namespace: default
    chart: ./gateway-api

  - name: gateway-api-inference-extension-crds
    namespace: default
    chart: ./gateway-api-inference-extension

  - name: node-feature-discovery
    namespace: node-feature-discovery
    createNamespace: true
    chart: oci://registry.k8s.io/nfd/charts/node-feature-discovery
    version: "0.19.0"

  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: oci://quay.io/jetstack/charts/cert-manager
    version: "1.21.2"
    values:
      - crds:
          enabled: true

  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
    version: "91.4.1"
    values:
      - prometheus:
          prometheusSpec:
            serviceMonitorSelectorNilUsesHelmValues: false
            podMonitorSelectorNilUsesHelmValues: false
            probeSelectorNilUsesHelmValues: false
            ruleSelectorNilUsesHelmValues: false
            retention: 15d
            resources:
              requests:
                cpu: 200m
                memory: 512Mi
              limits:
                memory: 1Gi
        alertmanager:
          alertmanagerSpec:
            resources:
              requests:
                cpu: 50m
                memory: 64Mi
              limits:
                memory: 128Mi
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeProxy:
          enabled: false
        kubeEtcd:
          enabled: false
        grafana:
          defaultDashboardsEnabled: true
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
          {{- with .Values | get "kube-prometheus-stack.grafana" nil }}
          {{- toYaml . | nindent 10 }}
          {{- end }}

  - name: prometheus-adapter
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/prometheus-adapter
    version: "5.3.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - prometheus:
          url: http://kube-prometheus-stack-prometheus.monitoring.svc
          port: 9090

  - name: milvus-operator
    namespace: milvus-operator
    createNamespace: true
    chart: milvus-operator/milvus-operator
    version: "1.3.11"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - monitoringEnabled: true

  - name: cnpg
    namespace: cnpg-system
    createNamespace: true
    chart: cnpg/cloudnative-pg
    version: "0.29.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - monitoring:
          podMonitorEnabled: true
          grafanaDashboard:
            create: true

  - name: postgres
    namespace: postgres
    createNamespace: true
    chart: cnpg/cluster
    version: "0.8.1"
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-postgres-temporal-role-secret.sh"]
    {{- end }}
    needs:
      - cnpg-system/cnpg
      - monitoring/kube-prometheus-stack
    values:
      - cluster:
          monitoring:
            enabled: true
          roles:
            - name: temporal
              ensure: present
              login: true
              createdb: true
              passwordSecret:
                name: temporal-db-secret

  - name: temporal
    namespace: temporal
    createNamespace: true
    chart: temporal/temporal
    version: "1.7.0"
    {{- if eq .Environment.Name "development" }}
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-temporal-db-secret.sh"]
    {{- end }}
    needs:
      - postgres/postgres
      - monitoring/kube-prometheus-stack
    values:
      - server:
          metrics:
            serviceMonitor:
              enabled: true
          config:
            persistence:
              datastores:
                default:
                  sql: &temporalSql
                    pluginName: postgres12_pgx
                    driverName: postgres12_pgx
                    databaseName: temporal
                    connectAddr: postgres-cluster-rw.postgres.svc.cluster.local:5432
                    connectProtocol: tcp
                    user: temporal
                    existingSecret: temporal-db-secret
                visibility:
                  sql:
                    <<: *temporalSql
                    databaseName: temporal_visibility

  # Temporal Worker Controller
  # Manages worker versioning, traffic routing, and progressive rollout
  # https://github.com/temporalio/temporal-worker-controller
  - name: temporal-worker-controller-crds
    chart: oci://docker.io/temporalio/temporal-worker-controller-crds
    namespace: default
    version: "0.30.0"

  - name: temporal-worker-controller
    chart: oci://docker.io/temporalio/temporal-worker-controller
    namespace: temporal
    version: "0.30.0"
    needs:
      - temporal/temporal
      - default/temporal-worker-controller-crds

  - name: dragonfly-operator
    namespace: dragonfly-operator
    createNamespace: true
    chart: oci://ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator
    version: "v1.7.0"
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - serviceMonitor:
          enabled: true
      - grafanaDashboard:
          enabled: true

  - name: dragonfly
    namespace: dragonfly
    createNamespace: true
    chart: ./dragonfly
    needs:
      - dragonfly-operator/dragonfly-operator

  - name: gpu-operator
    namespace: gpu-operator
    createNamespace: true
    chart: oci://nvcr.io/nvidia/cloud-native-charts/gpu-operator
    version: "v26.7.1"
    needs:
      - node-feature-discovery/node-feature-discovery
      - monitoring/kube-prometheus-stack
    values:
      - nfd:
          enabled: false
      {{- with .Values | get "gpu-operator.values" nil }}
      {{- toYaml . | nindent 6 }}
      {{- end }}

  - name: agentgateway-crds
    namespace: agentgateway-system
    createNamespace: true
    chart: oci://cr.agentgateway.dev/charts/agentgateway-crds
    version: "v1.5.0"

  - name: agentgateway
    namespace: agentgateway-system
    chart: oci://cr.agentgateway.dev/charts/agentgateway
    version: "v1.5.0"
    needs:
      - default/gateway-api-crds
      - default/gateway-api-inference-extension-crds
      - agentgateway-system/agentgateway-crds
      - monitoring/kube-prometheus-stack
    values:
      - inferenceExtension:
          enabled: true
      - monitoring:
          enabled: true

  - name: versitygw
    namespace: versitygw
    installed: {{ eq .Environment.Name "development" | toYaml }}
    createNamespace: true
    chart: oci://ghcr.io/versity/versitygw/charts/versitygw
    version: "0.4.4"
    hooks:
      - events: ["presync"]
        command: bash
        args: ["hooks/dev-versitygw-root-secret.sh"]
    needs:
      - agentgateway-system/agentgateway
      - cert-manager/cert-manager
    values:
      - auth:
          existingSecret: versitygw-root-secret
      - gateway:
          backend:
            type: posix
      - persistence:
          enabled: true

  - name: milvus
    namespace: milvus
    createNamespace: true
    chart: ./milvus
    forceConflicts: true
    needs:
      - milvus-operator/milvus-operator

  - name: squint
    namespace: squint
    createNamespace: true
    chart: ./squint
    needs:
      - gpu-operator/gpu-operator
      - agentgateway-system/agentgateway
      - monitoring/kube-prometheus-stack
      - milvus/milvus

  - name: squint-dev
    namespace: squint
    installed: {{ eq .Environment.Name "development" | toYaml }}
    chart: ./squint-dev
    needs:
      - squint/squint
