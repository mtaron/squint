{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "squint/python/apps/ingest"
		},
		{
			"path": "squint/python/apps/embed"
		},
		{
			"path": "squint/python/apps/extract"
		},
		{
			"path": "squint/javascript/ui"
		},
		{
			"path": "squint/javascript/db"
		},
		{
			"path": "squint/python/packages/squint-core"
		},
		{
			"path": "squint/python/packages/squint-vector"
		},
		{
			"path": "squint/python/devtools"
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.jj": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/__pycache__": true,
			"**/.venv": true,
			"**/.ruff_cache": true,
			"**/.pytest_cache": true,
			"**/.task": true,
			"**/.playwright-mcp": true
		},
		"files.associations": {
			"*.yaml.gotmpl": "helm",
			"**/infrastructure/kind/cluster.yaml": "helm"
		},
		"editor.formatOnSave": true,
		"[python]": {
			"editor.defaultFormatter": "charliermarsh.ruff"
		},
		"[javascript]": {
			"editor.defaultFormatter": "oxc.oxc-vscode"
		},
		"python.languageServer": "None",
		"python.testing.pytestArgs": [
			"tests"
		],
		"python.testing.unittestEnabled": false,
		"python.testing.pytestEnabled": true
	},
	"extensions": {
		"recommendations": [
			"astral-sh.ty",
			"charliermarsh.ruff",
			"ms-kubernetes-tools.vscode-kubernetes-tools",
			"ms-playwright.playwright",
			"ms-python.python",
			"oxc.oxc-vscode",
			"svelte.svelte-vscode",
			"svelte.svelte-vscode",
			"task.vscode-task",
			"tilt-dev.Tiltfile",
			"TomlSmith.tomlsmith",
			"vitest.explorer"
		]
	}
}
