{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "scratch"
		},
		{
			"path": "src/python/apps/ingest"
		},
		{
			"path": "src/python/apps/embed"
		},
		{
			"path": "src/python/apps/extract"
		},
		{
			"path": "src/python/packages/squint-core"
		}
	],
	"settings": {
		"yaml.schemas": {
			"https://www.schemastore.org/kind-cluster.json": "infrastructure/cluster.yaml"
		},
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.jj": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/__pycache__": true,
			"**/.venv": true,
			"**/.ruff_cache": true,
			"**/.task": true
		},
		"[python]": {
			"editor.formatOnSave": true,
			"editor.defaultFormatter": "charliermarsh.ruff"
		},
		"python.languageServer": "None"
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-kubernetes-tools.vscode-kubernetes-tools",
			"charliermarsh.ruff",
			"task.vscode-task",
			"astral-sh.ty"
		]
	}
}
