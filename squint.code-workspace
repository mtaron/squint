{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "scratch"
		},
		{
			"path": "squint/python/apps/ingest"
		},
		{
			"path": "squint/python/apps/embed"
		},
		{
			"path": "squint/python/apps/extract"
		},
		{
			"path": "squint/python/packages/squint-core"
		},
		{
			"path": "squint/python/packages/squint-vector"
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.jj": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/__pycache__": true,
			"**/.venv": true,
			"**/.ruff_cache": true,
			"**/.task": true
		},
		"files.associations": {
			"*.yaml.gotmpl": "helm",
			"**/infrastructure/kind/cluster.yaml": "helm"
		},
		"[python]": {
			"editor.formatOnSave": true,
			"editor.defaultFormatter": "charliermarsh.ruff"
		},
		"python.languageServer": "None"
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-kubernetes-tools.vscode-kubernetes-tools",
			"charliermarsh.ruff",
			"task.vscode-task",
			"astral-sh.ty",
			"tilt-dev.Tiltfile"
		]
	}
}
