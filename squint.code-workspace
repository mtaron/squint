{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "scratch"
		}
	],
	"settings": {
		"yaml.schemas": {
			"https://www.schemastore.org/kind-cluster.json": "infrastructure/cluster.yaml"
		},
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.jj": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/__pycache__": true,
			"**/.venv": true,
			"**/.ruff_cache": true
		}
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-kubernetes-tools.vscode-kubernetes-tools",
			"charliermarsh.ruff",
			"task.vscode-task"
		]
	}
}
