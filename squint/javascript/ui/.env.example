# Postgres
PGHOST="localhost"
PGPORT="5432"
PGUSER=""
PGPASSWORD=""
PGDATABASE="app"

# Temporal
TEMPORAL_ADDRESS="localhost:7233"

# Dragonfly; TLS files are passed as redis-py style query parameters
REDIS_URL="rediss://localhost:6379?ssl_ca_certs=ca.crt&ssl_certfile=tls.crt&ssl_keyfile=tls.key"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
