{
  "name": "@squint/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "test -n \"$PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD\" || (playwright install chromium && node scripts/link-chromium.mjs)",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright install && playwright test",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output ../db/src/auth.schema.ts --yes"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation-grpc": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-redis": "^0.72.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/interceptors-opentelemetry": "^1.25.0",
    "@temporalio/workflow-streams": "^1.25.0",
    "import-in-the-middle": "^3.5.3",
    "nanoid": "^6.0.2",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "^1.64.1",
    "@squint/db": "workspace:*",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@unocss/preset-icons": "^66.12.0",
    "@unocss/vite": "^66.12.0",
    "@vitest/browser-playwright": "^5.1.0",
    "auth": "^1.7.15",
    "better-auth": "^1.7.15",
    "browserslist": "^4.29.5",
    "drizzle-orm": "^0.45.4",
    "lightningcss": "^1.33.0",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^2.2.1"
  },
  "browserslist": [
    "defaults"
  ]
}
