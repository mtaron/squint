{
  "name": "squint",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright install && playwright test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation-grpc": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-redis": "^0.72.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@temporalio/client": "^1.24.0",
    "import-in-the-middle": "^3.5.2",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^4.1.12",
    "auth": "^1.7.11",
    "better-auth": "^1.7.11",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "vitest-browser-svelte": "^2.2.1"
  },
  "packageManager": "pnpm@12.11.2"
}
