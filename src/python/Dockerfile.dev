# syntax=docker/dockerfile:1
FROM ubuntu:26.04

RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3.14 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=python3.14 \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

ARG APP
COPY apps/${APP} /app/apps/${APP}
COPY packages /app/packages

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project "/app/apps/${APP}" --frozen --no-install-project --no-install-local \
    && uv pip install --python /opt/venv/bin/python debugpy

# Stand-in for editable installs of the local packages: put each package's
# src directory on sys.path, which is all an editable install would do.
RUN site_packages="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && for pyproject in /app/packages/*/pyproject.toml; do \
         echo "$(dirname "$pyproject")/src"; \
       done > "$site_packages/squint-packages.pth"

WORKDIR /app/apps/${APP}

EXPOSE 5678

# Frozen stdlib modules can make debugpy miss breakpoints
ENTRYPOINT ["python", "-Xfrozen_modules=off", "-m", "debugpy", "--listen", "0.0.0.0:5678"]
